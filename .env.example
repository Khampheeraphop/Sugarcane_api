# Export these variables in the host environment; no automatic dotenv loader.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set a secret on a public inference host and the matching Cloudflare Worker.
# INFERENCE_API_SECRET=replace-with-a-private-random-value

# Low-memory hosting uses the versioned ONNX artifact.
# INFERENCE_BACKEND=onnx
# REQUIRE_MODEL=1
